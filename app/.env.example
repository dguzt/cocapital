# Copy to .env.local and fill in from the Neon console (Connect → Drizzle) or
# `npx neonctl connection-string <branch>`.
#
# DATABASE_URL          — pooled connection (host has "-pooler"); app runtime.
# DATABASE_URL_UNPOOLED — direct connection (no "-pooler"); drizzle-kit migrations.
#
# Each environment points at its own Neon branch: a dev branch locally, the
# production branch in prod. Same code, only the connection string changes.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
