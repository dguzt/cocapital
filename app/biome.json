{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!src/backend/infra/db/migrations"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noUnknownAtRules": "off"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../*", "../**"],
                "message": "Import from a parent folder with the alias (@/ or @tests/); use ./ only for siblings."
              }
            ]
          }
        }
      },
      "complexity": {
        "noStaticOnlyClass": "off"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/backend/modules/*/domain/**",
        "src/backend/modules/*/ports/**",
        "src/backend/modules/*/usecases/**",
        "src/backend/shared/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../*", "../**"],
                    "message": "Import from a parent folder with the alias (@/ or @tests/); use ./ only for siblings."
                  },
                  {
                    "group": [
                      "next",
                      "next/**",
                      "@clerk/**",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "@neondatabase/**"
                    ],
                    "message": "The core (domain, ports, use cases) stays framework-free; reach Next, Clerk or Drizzle through an adapter."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
